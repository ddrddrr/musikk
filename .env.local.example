# env used for local development,
# i.e. with Django/Node devservers running on your machine

### BACKEND
# Django
DJANGO_SETTINGS_MODULE=musikk.settings.local
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8005

SECRET_KEY=*VERY SECRET KEY*

# Celery
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://:password@localhost:6375/2
#CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_ACKS_ON_FAILURE_OR_TIMEOUT=True
CELERY_TASK_REJECT_ON_WORKER_LOST=False
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Media/static
# Provide a fullpath here
# If not specified media files will be located under the root of the project (where src dir lives)
#MEDIA_ROOT=/home/*user*/musikk/media

# Provide a relative directory to MEDIA_ROOT
#AUDIO_CONTENT_PATH=audio

MEDIA_URL=media/
STATIC_URL=static/

# Binaries
FFMPEG_BIN=./tools/bin/ffmpeg
SHAKA_PACKAGER_BIN=./tools/bin/packager-osx-arm64
FFPROBE_BIN=./tools/bin/ffprobe

# Auth
ACCOUNT_RATE_LIMITS=False

# Postgres
SQL_ENGINE=django.db.backends.postgresql
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Redis
REDIS_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6375
REDIS_DB=1

# Mail
EMAIL_BACKEND=anymail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=from@example.com
SERVER_EMAIL=server@example.com

# set if using mailgun instead of console
#MAILGUN_API_KEY
#MAILGUN_API_URL
#MAILGUN_SENDER_DOMAIN

# used for redirect in mail
FRONTEND_URL=localhost:5175

### FRONTEND
# used for CORS/CSRF by BE
VITE_PORT=5175