# env for the production server at musikk.stream.
# Copy to .env.prod on the server and replace every !!!SET ...!!! value.
# Start the stack with `docker compose --env-file .env.prod -f docker-compose-prod.yml up -d --build`.
# Do not use $ in values, because Docker Compose reads it as the start of a variable.
#
# Do not add CSRF_COOKIE_SECURE, SESSION_COOKIE_SECURE, SECURE_SSL_REDIRECT, ACCOUNT_EMAIL_VERIFICATION or CADDYFILE.
# Without them the secure defaults apply: https-only cookies, the redirect to https,
# the email confirmation on sign-up, and src/frontend/Caddyfile.prod.

## Django
SERVICE_URL=https://musikk.stream
FRONTEND_URL=https://musikk.stream

DJANGO_SETTINGS_MODULE=musikk.settings.prod
DEBUG=False
# localhost is for the healthcheck of the server container
DJANGO_ALLOWED_HOSTS=musikk.stream,localhost

# python3 -c "import secrets; print(secrets.token_urlsafe(50))" prints a key without $
SECRET_KEY=!!!SET SECRET_KEY!!!

## Sign-up
# only people who got this password from you can create an account, empty opens sign-up to everyone
SIGNUP_PASSWORD=!!!SET SIGNUP_PASSWORD!!!

## Celery
# if not set, the broker URL is built from the REDIS_* values below
#CELERY_BROKER_URL=
#CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_ACKS_ON_FAILURE_OR_TIMEOUT=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

## Media
MEDIA_ROOT=/app/media
# relative to MEDIA_ROOT, Django storage rejects absolute paths
#AUDIO_CONTENT_PATH=audio
MEDIA_URL=media/
STATIC_URL=static/

## Postgres
SQL_ENGINE=django.db.backends.postgresql
POSTGRES_USER=musikk_user
POSTGRES_PASSWORD=!!!SET POSTGRES_PASSWORD!!!
POSTGRES_DB=musikk_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

## Redis
REDIS_PASSWORD=!!!SET REDIS_PASSWORD!!!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

## Mail
# prod settings refuse to start without EMAIL_DELIVERY_BACKEND
EMAIL_DELIVERY_BACKEND=anymail.backends.mailgun.EmailBackend
MAILGUN_API_KEY=!!!SET MAILGUN_API_KEY!!!
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=mail.musikk.stream
DEFAULT_FROM_EMAIL=no-reply@mail.musikk.stream
SERVER_EMAIL=server@mail.musikk.stream

## Binaries
FFMPEG_BIN=/opt/ffmpeg/bin/ffmpeg
FFPROBE_BIN=/opt/ffmpeg/bin/ffprobe
SHAKA_PACKAGER_BIN=/opt/ffmpeg/bin/packager
