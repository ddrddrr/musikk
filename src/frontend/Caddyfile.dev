:80 {
    handle_path /static/* {
        root /app/staticfiles
        file_server
    }
    handle_path /media/* {
        root /app/media
        file_server
    }
    handle /api/* {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        root /var/www/frontend
        try_files {path} /index.html
        file_server
    }
}
