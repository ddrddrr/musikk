:80 {
    handle_path /static/* {
        root /app/staticfiles
        file_server
    }
    handle_path /media/* {
        forward_auth server:8000 {
            uri /api/v1/media-access
        }
        # the browser keeps its copy but asks again before each reuse, so every reuse passes the login check
        header Cache-Control "private, no-cache"
        root /app/media
        file_server
    }
    handle /api/* {
        # a multipart body is a bit larger than the file in it, so this sits above MAX_FILE_SIZE (2 GiB)
        request_body {
            max_size 2100MiB
        }
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle /ws/* {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        root /var/www/frontend
        try_files {path} /index.html
        file_server
    }
}
