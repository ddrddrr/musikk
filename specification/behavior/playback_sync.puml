@startuml PlaybackSync

!include ../_style.puml

title Cross-tab playback sync

actor User as user

box "Frontend" #EEF2F8
participant "Active tab\n(<audio> + Shaka)" as active_tab
participant "Passive tabs\n(progress bar/song info,\nno audio element)" as passive_tabs
end box

box "Backend" #F8EFE5
participant "PlaybackController" as backend
database "Database" as database
end box

note over active_tab, passive_tabs
Only the active tab owns an HTMLAudioElement
and decodes audio. Passive tabs render position
from the server snapshot fields
(last_known_song_pos_ms, last_known_at_server_ms)
plus elapsed clock time on the client.
end note

== Periodic sync (active tab only) ==
note over active_tab : audio playing
active_tab -> backend : ws action "playback.sync"\n{ song_pos_ms, current_song_uuid }
backend -> backend : drop if FE current_song_uuid is stale
backend -> database : update PlayerState\n(last_known_song_pos_ms,\nlast_known_at_server_ms)

== Snapshot broadcast ==
backend -->> passive_tabs : broadcast ws event "playback.snapshot"\n(active tab excluded)
passive_tabs -> user : advance progress bar\n(synced with server clock)

== Seek (any tab) ==
user -> passive_tabs : move seek knob
passive_tabs -> backend : ws action "playback.seek"\n{ song_pos_ms, current_song_uuid }
backend -> database : update PlayerState
backend -->> active_tab : broadcast ws event "playback.seek"
active_tab -> user : reposition <audio>,\naudio jumps to new position
backend -->> passive_tabs : broadcast ws event "playback.snapshot"
passive_tabs -> user : progress bar jumps to new position

@enduml
