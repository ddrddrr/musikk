@startuml FrontendUser

!include ../../_style.puml

title User feature - component hierarchy and IO boundary

package "Pages" {
    [ProfilePage]
}

package "Presentation" {
    [ProfileForm]
    [Connections]
    [UserCard]
    [UserAvatar]
    [UserIdentifier]
}

ProfilePage --> ProfileForm
ProfilePage --> UserAvatar
Connections --> UserCard
UserCard --> UserAvatar
UserCard --> UserIdentifier
UserIdentifier --> UserAvatar

package "State" {
    [UserConnectionsProvider] as connections_provider
    [useFollowUser] as use_follow
    [useUserWsEvents] as use_user_ws
    [useUserLibrary / useUserLikes] as use_library_likes
}

cloud "Backend\n/api/v1" as backend
queue "WSClient\nuser group" as ws

ProfilePage ...> use_follow : uses
UserCard ...> use_follow : uses
Connections ...> connections_provider : reads

ProfilePage ...> backend : GET /users/{uuid}
ProfileForm ..> backend : PATCH /users/me
connections_provider ..> backend : GET /users/{uuid}/* (friends, followers, followed)
use_follow ..> backend : POST, DELETE /users/{uuid}/followed
use_library_likes ..> backend : GET /me/liked-* (songs, collections)\nGET /users/{uuid}/library

use_user_ws <.. ws : user.updated / followed / unfollowed\nuser.liked_*.changed (songs, collections)\nuser.library.changed
use_user_ws ..> use_library_likes : invalidates userKeys.*

note as combined_note
  == UserConnectionsProvider
  Mounted by HomePage; caches the current user's
  friends / followers / followed.
  == useFollowUser
  Invalidates userKeys.* via queryClient after each call.
  == useUserLibrary / useUserLikes
  /users/{uuid}/library route lives in the collections feature.
  == useUserWsEvents
  Registered globally via useWebSocketListeners,
  not mounted by user components.
end note

@enduml
