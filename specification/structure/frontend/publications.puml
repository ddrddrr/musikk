@startuml FrontendPublications

!include ../../_style.puml

title Publications - component hierarchy and IO boundary

package "Posts (Feed)" {
    [GlobalFeed\n+ PostCreateButton / PostCreateDialog\n+ useGlobalFeedPostsFlat\n+ useNewFeedPosts] as global_feed
    [UserFeed\n+ useFeedPostsFlat\n+ useNewFeedPosts] as user_feed
    [PostTabContent] as post_tab
    [PostTree\n+ PostHeader / PostReplies /\n  PostReplySection / PostForm /\n  PostAttachment] as post_tree
    cloud "Backend\n/api/v1" as backend_posts
}

global_feed --> post_tab
post_tab --> post_tree
user_feed --> post_tree

global_feed ..> backend_posts : GET /feed/posts
user_feed ..> backend_posts : GET /feed/{user_uuid}/posts
post_tree ..> backend_posts : GET, POST /publications/{uuid}/children\nPOST /feed/posts

package "Collection Comments" {
    [CommentBox\n+ CommentList\n+ CommentForm / Comment\n+ useCollectionCommentsFlat\n+ useCollectionCommentsWsEvents\n+ useTypingIndicator (send + receive)\n+ scroll hooks] as comment_box
    cloud "Backend\n/api/v1" as backend_comments
    queue "WSClient\ncollection_comments.{uuid}" as ws_comments
}

comment_box ..> backend_comments : GET, POST /collections/{uuid}/comments
comment_box <..> ws_comments : collection.comments.changed

package "Chat" {
    [ChatBoxRouteHandler / ChatPreviewList\n+ UserChatsProvider\n+ useUserChatsWsEvents\n  (global cache invalidation)] as chat_entry
    [ChatBox\n+ ChatHeader / ChatMessageList /\n  ChatMessageForm / ChatMessage\n+ useChatMessagesFlat\n+ useChatWsEvents\n+ useTypingIndicator (send + receive)\n+ scroll hooks (useScrollAnchor /\n  useAutoScrollToBottom /\n  useNewMessagesIndicator)] as chat_box
    [ChatStartDirectList / ChatNewGroupForm] as chat_start
    cloud "Backend\n/api/v1" as backend_chat
    queue "WSClient\nchat.{uuid} +\nper-user group" as ws_chat
}

chat_entry --> chat_box
chat_entry --> chat_start

chat_box ..> backend_chat : GET, POST /users/{uuid}/chats/{chat}/messages
chat_start ..> backend_chat : POST /users/{uuid}/chats\nPOST .../{chat}/members
chat_box <..> ws_chat : chat.messages.changed
chat_entry <.. ws_chat : chat.messages.changed\n(per-user group)

note as combined_note
  == Shared building blocks
  - AttachmentPicker: post and chat composers
  - LoadOlder / LoadNewerButton: post tree, chat, comments
  - NewMessagesIndicator: chat
  - TypingIndicator: chat, comments
  ==  Typing indicator (chat + comments)
  - client sends action "typing" { topic }
  - server emits {topic}.typing back on the same topic
  == Duplication
  All Backend / WSClient nodes refer to the same service
  and the same WS connection - duplicated per package
  for readability.
end note

@enduml
