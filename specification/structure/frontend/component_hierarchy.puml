@startuml FrontendComponentHierarchy

!include ../../_style.puml

package "main.tsx" {
    [QueryClientProvider\n(TanStack Query)] as query_provider
    [ErrorBoundary] as error_boundary
    query_provider --> error_boundary
}

package "App.tsx" {
    [BrowserRouter] as router
    [AuthProvider\n(useQuery /me via api_client_public,\nregisters logout in authRef)] as auth

    package "Public routes" {
        [LoginPage]
        [SignUpPage]
        [EmailVerificationPage]
    }

    [RequireAuth\n(redirect if not authenticated)] as require_auth

    package "Authenticated providers" as authenticated_providers {
        [WebSocketProvider\n(WSClient singleton, /ws/user)] as ws_provider
        [DeviceListProvider] as device_list_provider
        [PlaybackProvider\n(AudioPlayerController,\nuseSyncExternalStore)] as playback_provider
        [LoudnessPresetProvider] as loudness_provider
    }

    package "AuthenticatedApp" as authenticated_app {
        [useWebSocketListeners\n(global WS event handlers,\ndevice lifecycle)] as ws_listeners
        package "AuthenticatedLayout (Outlet host)" {
            [Header / left col / right col] as layout_columns
            [HomePage\n(also mounts UserConnectionsProvider,\nUserChatsProvider)] as home_page
            [AlbumUploadPage / SettingsPage] as other_pages
            [PlayerBox\n(<audio> elem, Shaka player,\nplayback controls)] as player
            [Toaster (sonner)] as toast
        }
    }
}

package "Network Clients" {
    [WSClient] as ws_client
    [axios api_client] as api_client
    [axios api_client_public] as api_client_public
    [authRef.logout] as auth_ref
}

error_boundary --> router
router --> auth
auth --> require_auth
require_auth --> authenticated_providers
authenticated_providers --> authenticated_app

ws_provider .up.> ws_client : owns
ws_listeners ...> ws_client : registers global WS handlers
api_client ..> auth_ref : 401 -> logout
auth ..> api_client_public : GET /users/me
authenticated_app ..> api_client : uses
"Public routes" ..up.> api_client_public : uses

@enduml
