@startuml FrontendPlayback

!include ../../_style.puml

title Playback and devices - component hierarchy and IO boundary

package "Presentation (player/)" {
    [PlayerBox\n(<audio> element)] as player_box
    [PlayerBar] as player_bar
    [PlayerPlayButton] as play_button
    [ChangeActiveDeviceDropdown] as device_dropdown
}

package "Presentation (settings/)" {
    [LoudnessPresetSelector] as loudness_selector
}

player_box --> player_bar
player_bar --> play_button
player_bar --> device_dropdown

package "State (providers + hooks)" {
    component "PlaybackProvider\n+ usePlayer (autoplay, onEnded)\n+ useSubscribePlaybackEvents\n+ useCalculateSongPosMs\n+ useHandlePlay" as playback_provider {
        [AudioPlayerController] as controller
        [ActivePlayback] as active_playback
        [RemotePlayback] as remote_playback
        [LocalAudioOutput\n(Shaka + audio elem)] as audio_output

        controller --> active_playback : this tab plays
        controller --> remote_playback : another tab plays
        active_playback --> audio_output : load / play / pause / seek
        remote_playback --> audio_output : unload
    }
    [DeviceListProvider\n+ useDeviceLifecycle (re-register on WS open)] as device_list_provider
    [LoudnessPresetProvider\n+ useAudioPipeline (WebAudio gain + loudness)] as loudness_provider
}

player_box ..> loudness_provider : uses
player_box ..> playback_provider : uses
player_bar ..> playback_provider : reads pos/dur,\napplyUserSeek
play_button ..> playback_provider : play / pause
device_dropdown ..> device_list_provider : reads / switch device
loudness_selector ..> loudness_provider : reads / writes
audio_output ..> loudness_provider : fade in / out

cloud "Backend\n(media / signed URLs)" as backend
queue "WSClient\nuser group" as ws

audio_output ...> backend : GET *.mpd / *.m3u8\nGET *.m4s segments

device_list_provider ..> ws : device.register
playback_provider ..> ws : playback.set\nplayback.active-device-report
device_dropdown ...> ws : device.set_active
player_bar ...> ws : device.set_volume

ws ..> device_list_provider : device.list
playback_provider <.... ws : playback.snapshot (with active device)\nplayback.set

@enduml
