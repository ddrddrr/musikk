@startuml FrontendPlayback

!include ../../_style.puml

title Playback and devices - component hierarchy and IO boundary

package "Presentation (player/)" {
    [PlayerBox\n(<audio> element)] as player_box
    [PlayerBar] as player_bar
    [PlayerPlayButton] as play_button
    [ChangeActiveDeviceDropdown] as device_dropdown
}

package "Presentation (settings/)" {
    [LoudnessPresetSelector] as loudness_selector
}

player_box --> player_bar
player_bar --> play_button
player_bar --> device_dropdown

package "State (providers + hooks)" {
    [PlaybackProvider\n+ AudioPlayerController (Shaka + audio elem)\n+ usePlayer (autoplay, onEnded)\n+ useSubscribePlaybackEvents\n+ useCalculateSongPosMs / useTotalDuration\n+ useHandlePlay] as playback_provider
    [DeviceListProvider\n+ useDeviceLifecycle (re-register on WS open)\n+ useHandleSwitchDevice] as device_list_provider
    [LoudnessPresetProvider\n+ useAudioPipeline (WebAudio gain + loudness)] as loudness_provider
}

player_box ..> loudness_provider : uses
player_box ..> playback_provider : uses
player_bar ..> playback_provider : reads pos/dur,\napplyUserSeek
play_button ..> playback_provider : activate playback
device_dropdown ..> device_list_provider : reads / switch device
loudness_selector ..> loudness_provider : reads / writes
playback_provider ..> loudness_provider : invokes fade/sync callbacks

cloud "Backend\n(media / signed URLs)" as backend
queue "WSClient\nuser group" as ws

playback_provider ...> backend : GET *.mpd / *.m3u8\nGET *.m4s segments

device_list_provider ..> ws : device.register
playback_provider ..> ws : device.set_active / set_volume\nplayback.activate / stop\nplayback.seek / sync

device_list_provider <.right. ws : device.list
playback_provider <.... ws : playback.snapshot\nplayback.seek

@enduml
