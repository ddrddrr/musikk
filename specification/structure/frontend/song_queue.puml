@startuml FrontendSongQueue

!include ../../_style.puml

title Song queue - component hierarchy and IO boundary
' Source: src/frontend/musikk/src/features/song-queue/

package "Presentation" {
    [SongQueue\n(now playing +\nqueue + clear)] as song_queue
    [SongQueuePlayButton] as queue_play_button
}

song_queue --> queue_play_button

package "State (hooks)" {
    [useQueue / useQueueClear] as queue_api_hooks
    [useQueuePlayHandler] as queue_play_handler
    [useQueueWsEvents] as queue_ws_events
}

song_queue ..> queue_api_hooks : uses
song_queue ..> queue_play_handler : uses
queue_play_button ..> queue_play_handler : uses

package "External providers" as external_providers {
    [PlaybackContext\n(playback feature)] as playback_context
}

song_queue ..> playback_context : reads (now playing)

cloud "Backend\n/api/v1" as backend
queue "WSClient\nuser group" as ws

' --- HTTP ---
queue_api_hooks ..> backend : GET /song-queue\nPOST /song-queue/clear\nPOST /song-queue/append-random
queue_play_handler ..> backend : POST /song-queue/set-head-song/{uuid}\nPOST /song-queue/set-head-collection/{uuid}\nPOST /song-queue/shift-head[/{uuid}]\nPOST /song-queue/shift-head-backwards
song_queue ..> backend : POST /song-queue/remove-node/{uuid}\nPOST /song-queue/reorder\nPOST /song-queue/move-to-queue\nPOST /song-queue/add-song/{uuid}\nPOST /song-queue/add-collection/{uuid}

' --- WS (events received) ---
queue_ws_events <.. ws : queue.changed
queue_ws_events ..> queue_api_hooks : invalidates queueKeys.base

@enduml
