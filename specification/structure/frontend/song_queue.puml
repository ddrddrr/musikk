@startuml FrontendSongQueue

!include ../../_style.puml

title Song queue - component hierarchy and IO boundary

package "Presentation" {
    [SongQueue\n(now playing +\nqueue + clear)] as song_queue
    [SongQueueActions\n(per-row)] as queue_row_actions
    [SongQueuePlayButton] as queue_play_button
}

song_queue --> queue_row_actions
queue_row_actions --> queue_play_button

package "State (hooks)" {
    [useQueue / useQueueClear] as queue_api_hooks
    [usePlaySong / usePlayCollection /\nuseAddSong / useAddCollection /\nuseMoveToQueue / useQueueNext / useQueuePrev] as queue_mutations
    [useQueuePlayHandler\n(per-row skipTo)] as queue_play_handler
    [useQueueWsEvents\n(global, via useWebSocketListeners)] as queue_ws_events
}

song_queue ..> queue_api_hooks : useQueue / useQueueClear
song_queue ..> queue_api_hooks : removeItem (inline mutation)
queue_play_button ..> queue_play_handler : uses

package "External providers" as external_providers {
    [PlaybackContext\n(playback feature)] as playback_context
}

song_queue ..> playback_context : reads (now playing)

cloud "Backend\n/api/v1" as backend
queue "WSClient\nuser group" as ws

queue_api_hooks ..> backend : GET /song-queue\nPOST /song-queue/clear
queue_play_handler ..> backend : POST /song-queue/shift-head/{uuid}
queue_mutations .up.> backend : POST /song-queue/* (set-head, add, move, shift)
song_queue ..> backend : POST /song-queue/remove-node/{uuid}

queue_ws_events <... ws : queue.changed
queue_ws_events ..> queue_api_hooks : invalidates queueKeys.base

@enduml
