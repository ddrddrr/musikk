@startuml BackendSystem

!include ../_style.puml

package "Reverse Proxy" as proxy

package "Application Server" as app {
    [REST API] as rest_api
    [WebSocket Handler] as ws_handler
    [Authentication] as auth
}

package "Audio Processing" as audio_pipeline {
    [Probe] as probe
    [Transcoder] as transcoder
    [Packager] as packager
}

database "Relational Database" as database
database "Redis\n(cache, pub/sub, task broker)" as redis

package "Background Workers" as workers {
    [Worker] as worker
}

folder "Media Storage" as media_storage

proxy ---> rest_api : API requests
proxy <--- rest_api : JSON responses

rest_api --> auth : login / logout / session
auth --> database : sessions, users
rest_api ----> database : read / write

proxy <--> ws_handler : WebSocket connection
ws_handler --> redis : per-user pub/sub
ws_handler ----> database : permission checks,\nstate reads

note right of ws_handler
The Server sends WS payload as "Events" to the Frontend
The Frontend sends WS payload as "Actions" to the Backend
end note

rest_api ----> redis : enqueue task
worker --> redis : pull task
worker ---> database : persist state
worker --> audio_pipeline : process audio
audio_pipeline --> media_storage : write segments/manifests
worker ---> redis : push events

proxy <---- media_storage : audio segments / manifests

probe -[hidden]- transcoder
transcoder -[hidden]- packager

@enduml
