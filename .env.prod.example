# env used for fully containerized development,
# i.e. with all services running in Docker, including the proxy.
# Copy to .env.prod and run `make run-local-full`. No further edits needed for local use.

## Django
SERVICE_URL=http://localhost
FRONTEND_URL=http://localhost
CADDYFILE=./src/frontend/Caddyfile.dev

DJANGO_SETTINGS_MODULE=musikk.settings.prod
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000

SECRET_KEY=local-dev-only-secret

# the prod settings module enables https-only cookies and ssl redirect by default
# turned off here because we serve plain http on localhost
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

## Celery
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_URL=redis://:password@redis:6379/2
#CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_ACKS_ON_FAILURE_OR_TIMEOUT=True
CELERY_TASK_REJECT_ON_WORKER_LOST=False
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

## Media
MEDIA_ROOT=/app/media
AUDIO_CONTENT_PATH=/app/media/audio
MEDIA_URL=media/
STATIC_URL=static/

## Postgres
SQL_ENGINE=django.db.backends.postgresql
POSTGRES_USER=musikk_user
POSTGRES_PASSWORD=musikk_password
POSTGRES_DB=musikk_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

## Redis
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

## Mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# default is "mandatory" which blocks login until the user clicks the verification link
# "none" lets accounts log in immediately
ACCOUNT_EMAIL_VERIFICATION=none
DEFAULT_FROM_EMAIL=no-reply@mail.musikk.stream
SERVER_EMAIL=server@mail.musikk.stream

# or any other mail provider, if you want to test with real mails
#MAILGUN_API_KEY=
#MAILGUN_API_URL=https://api.eu.mailgun.net/v3
#MAILGUN_SENDER_DOMAIN=mail.musikk.stream

## Binaries
FFMPEG_BIN=/opt/ffmpeg/bin/ffmpeg
FFPROBE_BIN=/opt/ffmpeg/bin/ffprobe
SHAKA_PACKAGER_BIN=/opt/ffmpeg/bin/packager

# Auth Redirect
FRONTEND_URL=http://localhost